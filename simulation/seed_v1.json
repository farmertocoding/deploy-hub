{
  "comment": "Simulation-mode seed v1 (§F8): v0 shape (2 zones, 4 targets, 6 sites) plus every Task-13 state. Scripted events publish finding payloads on `findings` (D-045); site/deploy status stay on the authorized site./deploy. prefixes. Warming carries elapsed_s/expected_s so the badge is reviewable.",
  "zones": [
    {"name": "zone-a-home", "kind": "home_lan", "cidr": "192.168.1.0/24"},
    {"name": "zone-b-office", "kind": "home_lan", "cidr": "10.0.0.0/24"},
    {"name": "aws-use1", "kind": "aws", "cidr": "10.10.0.0/16", "purpose": "test"}
  ],
  "targets": [
    {"name": "home-server-1", "zone": "zone-a-home", "kind": "ssh", "lifecycle": "permanent"},
    {"name": "home-server-2", "zone": "zone-a-home", "kind": "ssh", "lifecycle": "permanent"},
    {"name": "office-server-1", "zone": "zone-b-office", "kind": "ssh", "lifecycle": "permanent"},
    {"name": "burst-ec2-1", "zone": "aws-use1", "kind": "aws_ec2", "lifecycle": "ephemeral"}
  ],
  "sites": [
    {"domain": "shop.example.com", "tier": "prod", "target": "home-server-1"},
    {"domain": "api.example.com", "tier": "prod", "target": "home-server-1"},
    {"domain": "staging.shop.example.com", "tier": "staging", "target": "home-server-2"},
    {"domain": "blog.example.com", "tier": "prod", "target": "office-server-1"},
    {"domain": "lab.example.com", "tier": "experiment", "target": "home-server-2", "deploy_strategy": "recreate", "instances": 1, "single_instance": true},
    {"domain": "docs.example.com", "tier": "prod", "target": "office-server-1"}
  ],
