# Copy to .env and fill. .env is gitignored — secrets never in git (§10).
# Generate values:  python -c "import secrets; print(secrets.token_urlsafe(48))"
HUB_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_PROBES=
REDIS_PASSWORD=
REDIS_PASSWORD_PROBES=
# Compose mints HUB_VAULT_KEYFILE=/etc/deploy-hub/vault.key on first boot.
# Do not set HUB_VAULT_KEK_BACKEND=fake — compose/prod refuse it.
# Local source trees are off in production. Set both to enable a confined root.
# HUB_ALLOW_LOCAL_SOURCES=1
# HUB_LOCAL_SOURCE_ROOT=/var/lib/deploy-hub/sources
